# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Supabase PostgreSQL runtime connection
# Use the Supabase Transaction Pooler connection string for Vercel/Serverless.
SUPABASE_DB_URL=postgres://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_SSL=verify-full
SUPABASE_DB_SSL_CA="-----BEGIN CERTIFICATE-----\nreplace-with-full-supabase-ca-certificate\n-----END CERTIFICATE-----"

# Administrator authorization
MINICHI_ADMIN_EMAILS=admin@example.com
# Local http://localhost development should use false.
# Set this to true in Vercel Production (HTTPS).
MINICHI_AUTH_COOKIE_SECURE=false

# Private Cloudflare R2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=minichi-photos-production
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-access-key
R2_REGION=auto
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=900

# Upload policy
MINICHI_UPLOAD_MAX_BYTES=8388608


